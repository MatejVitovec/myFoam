FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs (
  "libfluidThermophysicalModels.so"
  "libmyFoam.so"
);

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         100;

deltaT          1e-6;

writeControl    timeStep;

writeInterval   5000;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo 0.8;

rDeltaTSmoothingCoeff 0.1;



functions
{
  totalPressureGas
  {
    type        totalPressure;
    libs        (libmyfieldFunctionObjects.so);

    field "U.1";
    phaseName "1";

    executeControl  writeTime;
    writeControl    writeTime;
  }

  alphaRho1
  {
    type            exprField;
    libs            (fieldFunctionObjects);

    field           alphaRho.1;
    expression       "alpha.1*\"thermo:rho.1\"";

    dimensions      [1 -3 0 0 0 0 0];

    executeControl  writeTime;
    writeControl    writeTime;
  }

  massFluxGas
  {
    type            flux;
    libs            (fieldFunctionObjects);

    field           U.1;
    rho             alphaRho.1;
    result          alphaRhoFlux.1;

    executeControl  writeTime;
    writeControl    writeTime;
  }

  massFlowGas
  {
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);

    writeFields     false;

    regionType      patch;
    name            outlet;

    operation       sum;
    fields          (alphaRhoFlux.1);

    executeControl  writeTime;
    writeControl    writeTime;
  }

  p0GasAverage
  {
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);

    writeFields     false;

    regionType      patch;
    name            outlet;

    operation       weightedAverage;
    fields          (p0.1);
    weightField     alphaRhoFlux.1;

    executeControl  writeTime;
    writeControl    writeTime;
  }

}


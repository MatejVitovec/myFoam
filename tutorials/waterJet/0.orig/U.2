FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0";
    object      U.2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (620.377 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (620.377 0 0);
    }
    
    outlet
    {
        type            zeroGradient;
    }

    waterInlet
    {
        //type            fixedValue;
        //value           uniform (0 28.65 0);
        type            slip;
    }

    bottomLeft
    {
        type            slip;
    }

    bottomRight
    {
        type            slip;
    }

    top
    {
        type            zeroGradient;
    }

    emptyPlanes1
    {
        type            empty;
    }

    emptyPlanes2
    {
        type            empty;
    }
}



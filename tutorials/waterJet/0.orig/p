FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 12410;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 12410;
    }

    outlet
    {
        type            zeroGradient;
    }

    waterInlet
    {
        type            zeroGradient;
    }

    bottomLeft
    {
        type            zeroGradient;
    }

    bottomRight
    {
        type            zeroGradient;
    }

    top
    {
        type            zeroGradient;
    }

    emptyPlanes1
    {
        type            empty;
    }

    emptyPlanes2
    {
        type            empty;
    }
}


